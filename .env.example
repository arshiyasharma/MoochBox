# MoochBox secrets. Copy this file to .env and fill it in.
# .env is gitignored. Never commit real values.

# --- Spotify (developer.spotify.com -> Dashboard -> your app -> Settings) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Filled in after running: python3 tools/get_token.py
SPOTIFY_REFRESH_TOKEN=

# --- Owner (only you). At least 10 characters, not reused anywhere else ---
MOOCHBOX_OWNER_PASSWORD=

# --- MoochBox WiFi network = the room. Only people with this password can join. ---
# 8+ characters (WPA2). Owner/host can change it at the party to kick everyone.
MOOCHBOX_WIFI_PASSWORD=

# --- Your phone hotspot, so MoochBox can reach Spotify (2.4 GHz) ---
MOOCHBOX_HOTSPOT_SSID=
MOOCHBOX_HOTSPOT_PASSWORD=
